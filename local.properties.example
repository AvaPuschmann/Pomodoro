# This file documents the variables expected in local.properties.
# `local.properties` itself is gitignored — copy this template and fill in values.

# Android SDK (required for Gradle)
# sdk.dir=C:\\Users\\<you>\\AppData\\Local\\Android\\Sdk

# Supabase credentials (required for sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mode Projet feature flags (Story 16-1) — defaults true in dev
# Override here for testing the "Free tier" rollout (FEATURE_PROJECTS=false):
# FEATURE_PROJECTS=true
# FEATURE_KANBAN_UI=true
